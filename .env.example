NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SESSION_SECRET=replace-with-at-least-32-random-characters
PII_ENCRYPTION_KEY=replace-with-64-hex-characters
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
PAYMENT_DEMO_MODE=false
# Optional explicit mode credentials for isolated development. Production accepts live only.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
# If the live signing secret is stored as RAZORPAY_WEBHOOK_SECRET, explicitly set this to live.
RAZORPAY_WEBHOOK_MODE=
# Set only after verifying the hosting proxy overwrites (not appends) this header.
# Without a trusted header, anonymous traffic shares the conservative "unknown" limit.
TRUSTED_CLIENT_IP_HEADER=
